# Base URL of archivum-api-hexagonal, including the /api/v1 prefix.
VITE_API_URL=http://localhost:8000/api/v1

# Slug of the store that the root of the client opens (the pilot store of the seeders).
VITE_DEFAULT_BUSINESS_SLUG=archivumparfums

# WhatsApp number for the store, with country code. Leave empty to hide the link.
VITE_STORE_WHATSAPP=
