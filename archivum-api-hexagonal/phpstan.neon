includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - app
        - src
        - database
        - tests
    ignoreErrors:
        # Pest applies the test traits with pest()->use(), which PHPStan cannot follow.
        -
            identifier: trait.unused
            path: tests/Support/*
        # Pest binds each test closure to the test case, which has those traits, but PHPStan reads $this as TestCall.
        -
            message: '#^Call to an undefined method Pest\\PendingCalls\\TestCall::scopeQueriesTo\(\)\.$#'
            identifier: method.notFound
            path: tests/Feature/*
