<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="archivum_hexagonal_testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Tests never use the real accounts of a local .env: each test configures the provider it fakes. -->
        <env name="TWILIO_SID" value="" force="true"/>
        <env name="TWILIO_TOKEN" value="" force="true"/>
        <env name="TWILIO_WHATSAPP_FROM" value="" force="true"/>
        <env name="TWILIO_WHATSAPP_TEST_NUMBERS" value="" force="true"/>
        <env name="TWILIO_WHATSAPP_MODE" value="" force="true"/>
        <env name="TWILIO_WHATSAPP_ORDER_CONTENT_SID" value="" force="true"/>
        <env name="TWILIO_WHATSAPP_APPOINTMENT_CONTENT_SID" value="" force="true"/>
        <env name="R2_ACCESS_KEY_ID" value="" force="true"/>
        <env name="R2_SECRET_ACCESS_KEY" value="" force="true"/>
        <env name="R2_BUCKET" value="" force="true"/>
        <env name="R2_ENDPOINT" value="" force="true"/>
        <env name="R2_PUBLIC_URL" value="" force="true"/>
    </php>
</phpunit>
